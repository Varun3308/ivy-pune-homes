{
  "name": "ivy-pune-homes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "audit:download": "node scripts/download.mjs",
    "audit:analyze": "node scripts/analyze.mjs",
    "audit:probe": "node scripts/probe.mjs",
    "format": "prettier --write client/src server shared scripts tests *.js *.json *.md",
    "audit:login": "node scripts/login.mjs",
    "audit:findings": "node scripts/findings.mjs",
    "audit": "npm run audit:login && npm run audit:download && npm run audit:probe && npm run audit:analyze && npm run audit:findings",
    "submission:check": "node scripts/check-submission.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  }
}
